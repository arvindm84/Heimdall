{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": { "mode": "token", "token": "${HEIMDALL_CHAT_TOKEN}" },
    "controlUi": { "enabled": false }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "heimdall": {
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
        "apiKey": "sk-fake-openclaw-01",
        "api": "openai-completions",
        "models": [
          {
            "id": "gemini-flash-lite-latest",
            "name": "gemini-flash-lite-latest",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": { "defaults": { "model": { "primary": "heimdall/gemini-flash-lite-latest" }, "skipBootstrap": true } },
  "tools": { "profile": "minimal", "alsoAllow": ["bundle-mcp"], "deny": ["session_status", "gateway"] },
  "mcp": {
    "servers": {
      "heimdall": {
        "url": "http://gateway:8000/mcp",
        "transport": "streamable-http",
        "requestTimeoutMs": 130000,
        "headers": { "Authorization": "Bearer sk-fake-openclaw-01" }
      }
    }
  },
  "plugins": {
    "entries": {
      "browser": { "enabled": false },
      "canvas": { "enabled": false },
      "cua-computer": { "enabled": false },
      "device-pair": { "enabled": false },
      "file-transfer": { "enabled": false },
      "geolocation": { "enabled": false },
      "linux-node": { "enabled": false },
      "talk-voice": { "enabled": false },
      "ollama": { "enabled": false },
      "openai": { "enabled": false },
      "xai": { "enabled": false }
    }
  }
}
